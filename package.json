{
  "name": "punch-list-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "package:mac": "vite build && electron-builder --mac",
    "package:mac:dmg": "vite build && electron-builder --mac dmg",
    "package:mac:zip": "vite build && electron-builder --mac zip",
    "package:win": "vite build && electron-builder --win",
    "package:win:nsis": "vite build && electron-builder --win nsis",
    "package:win:portable": "vite build && electron-builder --win portable",
    "package:all": "vite build && electron-builder --mac --win"
  },
  "dependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "clsx": "^2.1.1",
    "dexie": "^3.2.7",
    "dexie-react-hooks": "^1.1.7",
    "docx": "^9.15.4",
    "fabric": "^5.3.0",
    "firebase": "^13.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.2",
    "konva": "^9.3.14",
    "lucide-react": "^0.456.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.28.0",
    "uuid": "^10.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-window": "^7.3.0"
  },
  "build": {
    "appId": "com.sitevisitassistant.app",
    "productName": "Site Visit Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "universal",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "universal",
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Site Visit Assistant"
    }
  },
  "description": "Simply on-site reports for Architects and Contractors"
}
